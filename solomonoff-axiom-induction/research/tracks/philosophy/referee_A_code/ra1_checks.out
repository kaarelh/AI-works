## (3) noise regime: least-squares fits to the c4 data (N = 7306 daily heliocentric longitudes)
eccentric  RMS   15.812'   max   23.477'
equant     RMS    5.263'   max    8.388'
vicarious  RMS    0.628'   max    1.749'
ellipse    RMS    0.446'   max    1.252'
# expected penalty per independent Gaussian observation (bits) relative to the ellipse: (RMS_F^2 - RMS_ell^2)/(2 sigma^2 ln 2).  text = |LAW_F| - |LAW_ellipse| (c4 bits); where text < 0 the form is the shorter text and N* = -text/penalty observations overcome it; n/a: the ellipse is already shorter
  sigma 1'  eccentric  penalty 180.2136 bits/obs   N*(S1, text  -100) =      0.6   N*(S2, text  -312) =      1.7
  sigma 1'  equant     penalty  19.8395 bits/obs   N*(S1, text  +485) =      n/a   N*(S2, text  -204) =     10.3
  sigma 1'  vicarious  penalty   0.1416 bits/obs   N*(S1, text  +515) =      n/a   N*(S2, text  -186) =   1313.3
  sigma 2'  eccentric  penalty  45.0534 bits/obs   N*(S1, text  -100) =      2.2   N*(S2, text  -312) =      6.9
  sigma 2'  equant     penalty   4.9599 bits/obs   N*(S1, text  +485) =      n/a   N*(S2, text  -204) =     41.1
  sigma 2'  vicarious  penalty   0.0354 bits/obs   N*(S1, text  +515) =      n/a   N*(S2, text  -186) =   5253.3
# honest uniform-tolerance theories with eps_F = minimax error: per-datum cost difference log2(eps_F/eps_ell)
  eccentric  4.429 bits/datum; N*(S1) = 23, N*(S2) = 70
  equant     2.933 bits/datum; N*(S1) = n/a, N*(S2) = 70
  vicarious  0.398 bits/datum; N*(S1) = n/a, N*(S2) = 467


 n =  4096: T in 1..1499 where A1 is larger: none; A1 < 1/2 for T <= 102, BEHW < 1 for T <= 89; at T = 10: A1 0.036, BEHW 0.122 (n >= 8/eps holds: True)
 n = 16384: T in 1..1499 where A1 is larger: none; A1 < 1/2 for T <= 403, BEHW < 1 for T <= 322; at T = 10: A1 0.009, BEHW 0.033 (n >= 8/eps holds: True)


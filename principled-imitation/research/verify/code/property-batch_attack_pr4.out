    eps0 = 0.05: TV(nu1,Q) = 0.700, TV(nu2,Q) = 0.300, ratio 2.333; N =    11: Pr[Definition 3.4 returns the far one] = 0.274414;  Pr[the member nearest to the empirical measure is the far one] = 5.86e-03
    eps0 = 0.05: TV(nu1,Q) = 0.700, TV(nu2,Q) = 0.300, ratio 2.333; N =   101: Pr[Definition 3.4 returns the far one] = 0.500000;  Pr[the member nearest to the empirical measure is the far one] = 8.49e-18
    eps0 = 0.05: TV(nu1,Q) = 0.700, TV(nu2,Q) = 0.300, ratio 2.333; N =  1001: Pr[Definition 3.4 returns the far one] = 0.500000;  Pr[the member nearest to the empirical measure is the far one] = 3.72e-162
    eps0 = 0.01: TV(nu1,Q) = 0.740, TV(nu2,Q) = 0.260, ratio 2.846; N =    11: Pr[Definition 3.4 returns the far one] = 0.113281;  Pr[the member nearest to the empirical measure is the far one] = 4.88e-04
    eps0 = 0.01: TV(nu1,Q) = 0.740, TV(nu2,Q) = 0.260, ratio 2.846; N =   101: Pr[Definition 3.4 returns the far one] = 0.500000;  Pr[the member nearest to the empirical measure is the far one] = 2.03e-27

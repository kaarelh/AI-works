    N =   400, M =    10000: Pr[max >= (1/2) sqrt(ln M/N) = 0.0759] = 1.000000;  Pr[max > tol_N with pi = 1/M, delta = 0.1 (= 0.1235)] = 0.0065 (<= 0.1)

    N = 1024, K = 1000, b = log2(2N) = 11 bits, K/b = 90.9:  s = 0: 0.9995;  s = 81: 0.9995;  s = 90: 0.9985;  s = 101: 0.0000
    N = 1048576, K = 1000, b = log2(2N) = 21 bits, K/b = 47.6:  s = 0: 1.0000;  s = 42: 1.0000;  s = 47: 0.9999;  s = 53: 0.0000
  check report, test 3: log2 C(2^20, 1000) = 11469.9; Pr[1000 uniform inputs are distinct] = 0.621

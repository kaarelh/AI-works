  predictors: human(l=2), table1(l=4), table2(l=4), table3(l=4), KT(l=3), peek(z_{i+1})(l=4), momentum(l=4), fill1(l=5), mixH(l=3)
  total path probability = 1.000000000000000;  M_0 = Kraft sum = 0.84375
  E[M_n] for n = 1..N (must be <= M_0): 0.843750, 0.843750, 0.843750, 0.843750, 0.843750, 0.843750
  P[max_(k<=n) M_k >=   1.0] = 0.388062   Ville bound M_0/a = 0.843750
  P[max_(k<=n) M_k >=   1.5] = 0.238977   Ville bound M_0/a = 0.562500
  P[max_(k<=n) M_k >=   2.0] = 0.102906   Ville bound M_0/a = 0.421875
  P[max_(k<=n) M_k >=   4.0] = 0.040461   Ville bound M_0/a = 0.210938
  P[max_(k<=n) M_k >=   8.0] = 0.009829   Ville bound M_0/a = 0.105469
  P[max_(k<=n) M_k >=  16.0] = 0.003686   Ville bound M_0/a = 0.052734
  P[max_(k<=n) M_k >=  32.0] = 0.000687   Ville bound M_0/a = 0.026367

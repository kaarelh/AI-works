import NeuralGeneralization.RobustCompressionSelectedStateDraw

/-! # The literal canonical state law through the shared H decoder

For each fixed original matrix, the canonical state is generated by independent
uniform source indices followed by the literal residual coefficient law. The
decoder retains exactly the same rank/source-bank abort branch.
-/
noncomputable section
open MeasureTheory ProbabilityTheory
open scoped Classical ProbabilityTheory
namespace NeuralGeneralization.RobustCompressionCanonicalLayer
open ConcreteModel RobustEntropy RobustGaussianGeometry RobustCompressionInduction
open RobustCompressionReconstruction RobustCompressionLayerGaussian CompressionSampling
set_option maxHeartbeats 200000

variable {d N m s M q : ℕ} {Y : Type*} [MeasurableSpace Y]
  [MeasurableSpace (Finset (Fin M))] [MeasurableSingletonClass (Finset (Fin M))]
  [MeasurableSpace (QueryMessage (Fin M) q)]
  [MeasurableSingletonClass (QueryMessage (Fin M) q)]
local notation "P" => ActivePrefix d N m s
local notation "E" => EuclideanSpace ℝ (Fin N)
local notation "Rows" => Fin N → E
local notation "HRows" => Fin N → EuclideanSpace ℝ (Fin q)
local notation "S" => Fin m → Fin N
local notation "R" => Fin N → Fin m → ℝ

def selectedSourceMatrix (b : P → Fin M → E) (J : P × Y → Finset (Fin M))
    (a T : ℝ) (p : (P × Y) × S) : Fin m → Fin q → ℝ :=
  sampledMatrix (sourceRows (selectedMessageBasis (q:=q) b J p.1)) p.2 a T

theorem measurable_selectedSourceMatrix (b : P → Fin M → E) (hb : Measurable b)
    (J : P × Y → Finset (Fin M)) (hJ : Measurable J) (a T : ℝ) :
    Measurable (selectedSourceMatrix (m:=m) (q:=q) b J a T) := by
  have hm : Measurable (fun p : (P × Y) × S =>
      (sourceRows (selectedMessageBasis (q:=q) b J p.1),p.2)) :=
    (measurable_sourceRows.comp ((measurable_selectedMessageBasis b hb J hJ).comp
      measurable_fst)).prodMk measurable_snd
  have hc := (measurable_sampledMatrix (N:=N) (m:=m) (q:=q) a T).comp hm
  unfold selectedSourceMatrix
  simpa only [Function.comp_def] using hc

/-- Literal residual coefficient kernel, independent of H and of the test input. -/
def selectedSourceResidualKernel (b : P → Fin M → E) (hb : Measurable b)
    (J : P × Y → Finset (Fin M)) (hJ : Measurable J) (a T : ℝ) :
    Kernel ((P × Y) × S) R :=
  residualRowsKernel (selectedSourceMatrix (m:=m) (q:=q) b J a T)
    (measurable_selectedSourceMatrix b hb J hJ a T)

instance selectedSourceResidualKernel_markov (b : P → Fin M → E) (hb : Measurable b)
    (J : P × Y → Finset (Fin M)) (hJ : Measurable J) (a T : ℝ) :
    IsMarkovKernel (selectedSourceResidualKernel (m:=m) (q:=q) b hb J hJ a T) := by
  unfold selectedSourceResidualKernel
  infer_instance

theorem selectedSourceResidualKernel_apply (b : P → Fin M → E) (hb : Measurable b)
    (J : P × Y → Finset (Fin M)) (hJ : Measurable J) (a T : ℝ) (p : (P × Y) × S) :
    selectedSourceResidualKernel (q:=q) b hb J hJ a T p =
      Measure.pi (fun _ : Fin N => sourceResidualKernel (selectedSourceMatrix (q:=q) b J a T p)) :=
  residualRowsKernel_apply _ _ p

/-- Exact fixed-original-row factorization of the canonical next prefix. -/
theorem canonicalLayerKernel_selected_factor [NeZero N]
    {φ : ℝ → ℝ} (hφ : Continuous φ)
    (b : P → Fin M → E) (hb : Measurable b)
    (J : P × Y → Finset (Fin M)) (hJ : Measurable J)
    (a t T BH BG : ℝ) (θ : P × Y) (g : Rows) :
    canonicalLayerKernel hφ b hb a t T BH BG (selectedCanonicalInput (q:=q) J θ g) =
      ((iidSamples (uniformIndexLaw N) m) ⊗ₘ
        (selectedSourceResidualKernel (q:=q) b hb J hJ a T).comap
          (fun I : S => (θ,I)) measurable_prodMk_left).map
        (fun z => selectedStateFromH φ b J a t T BH BG θ
          (actualActiveH (selectedMessageBasis (q:=q) b J θ) t g,z)) := by
  let z := selectedCanonicalInput (q:=q) J θ g
  let state : ReconstructionOutput N m → ActivePrefix d N m (s+1) :=
    fun draw => stepActive z.1.1 draw (canonicalLayerSuccess φ b a T z draw)
  have hstate : Measurable state := by
    apply measurable_stepActive _ _ _ measurable_const measurable_id
    exact (measurable_canonicalLayerSuccess hφ b hb a T).comp
      (measurable_const.prodMk measurable_id)
  have hdecode : Measurable (fun draw : S × R =>
      selectedStateFromH φ b J a t T BH BG θ
        (actualActiveH (selectedMessageBasis (q:=q) b J θ) t g,draw)) :=
    (measurable_selectedStateFromH hφ b hb J hJ a t T BH BG).comp
      (measurable_const.prodMk (measurable_const.prodMk measurable_id))
  rw [canonicalLayerKernel,RobustCompression.parameterMap_apply,
    canonicalDrawKernel,Kernel.comap_apply]
  change (reconstructionKernel a t T BH BG (canonicalReconstructionInput b t z)).map state = _
  rw [reconstructionKernel_factor]
  ext s hs
  rw [Measure.map_apply hstate hs,Measure.compProd_apply (hstate hs),
    Measure.map_apply hdecode hs,Measure.compProd_apply (hdecode hs)]
  apply lintegral_congr
  intro I
  rw [Kernel.comap_apply,fixedSourceRowKernel_apply,
    Kernel.comap_apply,selectedSourceResidualKernel_apply]
  have hrows : Measurable (fixedSourceRowsDraw a t T BH BG
      (canonicalReconstructionInput b t z,I)) := by
    have hc := (measurable_fixedSourceRowsDraw (N:=N) (m:=m) (q:=q) a t T BH BG).comp
      (show Measurable (fun ξ : R => ((canonicalReconstructionInput b t z,I),ξ)) from
        measurable_const.prodMk measurable_id)
    simpa only [Function.comp_def] using hc
  rw [Measure.map_apply hrows ((hstate hs).preimage measurable_prodMk_left)]
  congr 1

end NeuralGeneralization.RobustCompressionCanonicalLayer

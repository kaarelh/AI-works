import NeuralGeneralization.RobustCompressionMessages
import NeuralGeneralization.RobustEntropyActiveQueries

/-!
# A measurable active family with exactly the bounded query width

The full input family is used to select a query subset. The actual active
Gaussian coordinates are generated by this q-slot list, with zero padding.
The span is exactly the selected input span, without paying the cardinality
of the entire Boolean cube in the active dimension.
-/

noncomputable section
open MeasureTheory

namespace NeuralGeneralization.ConcreteModel

def paddedQueryVectors {ι E : Type*} [Zero E] {q : ℕ}
    (b : ι → E) (S : BoundedQuerySubset ι q) : Fin q → E :=
  fun j => (encodeQuerySubset q S j).elim 0 b

theorem span_paddedQueryVectors {ι E : Type*} [AddCommGroup E] [Module ℝ E]
    {q : ℕ} (b : ι → E) (S : BoundedQuerySubset ι q) :
    Submodule.span ℝ (Set.range (paddedQueryVectors b S)) =
      Submodule.span ℝ (b '' (S.val : Set ι)) := by
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro _ ⟨j,rfl⟩
    cases h : encodeQuerySubset q S j with
    | none => simp [paddedQueryVectors,h]
    | some i =>
      have hi : i ∈ S.val := (mem_iff_encodeQuerySubset S i).mpr ⟨j,h⟩
      simpa [paddedQueryVectors,h] using
        (Submodule.subset_span (show b i ∈ b '' (S.val : Set ι) from ⟨i,hi,rfl⟩))
  · apply Submodule.span_le.mpr
    rintro _ ⟨i,hi,rfl⟩
    obtain ⟨j,hj⟩ := (mem_iff_encodeQuerySubset S i).mp hi
    apply Submodule.subset_span
    exact ⟨j,by simp [paddedQueryVectors,hj]⟩

theorem measurable_paddedQueryVectors_fixed {ι E : Type*} [Zero E]
    [MeasurableSpace E] {q : ℕ} (S : BoundedQuerySubset ι q) :
    Measurable (fun b : ι → E => paddedQueryVectors b S) := by
  apply measurable_pi_lambda
  intro j
  cases h : encodeQuerySubset q S j with
  | none => simpa [paddedQueryVectors,h] using
      (measurable_const : Measurable (fun _ : ι → E => (0 : E)))
  | some i => simpa [paddedQueryVectors,h] using
      (measurable_pi_apply i : Measurable (fun b : ι → E => b i))

/-- Joint measurability also permits a query subset selected from earlier
random variables. Its measurable space is the finite discrete one. -/
theorem measurable_paddedQueryVectors {ι E : Type*} [Fintype ι] [Zero E]
    [MeasurableSpace E] {q : ℕ}
    [MeasurableSpace (BoundedQuerySubset ι q)]
    [MeasurableSingletonClass (BoundedQuerySubset ι q)] :
    Measurable (fun p : (ι → E) × BoundedQuerySubset ι q =>
      paddedQueryVectors p.1 p.2) := by
  exact measurable_from_prod_countable_left
    (fun S => measurable_paddedQueryVectors_fixed S)

theorem paddedQueryVectors_span_inputSpan {N M q : ℕ}
    (b : Fin M → EuclideanSpace ℝ (Fin N))
    (S : BoundedQuerySubset (Fin M) q) :
    Submodule.span ℝ (Set.range (paddedQueryVectors b S)) =
      RobustEntropy.inputSpan b S.val :=
  span_paddedQueryVectors b S

end NeuralGeneralization.ConcreteModel

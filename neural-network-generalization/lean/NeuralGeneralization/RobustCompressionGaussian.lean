import NeuralGeneralization.GaussianTail
import NeuralGeneralization.RobustCompressionGluing
import Mathlib.Tactic.NormNum

/-!
# Gaussian reconstruction and clipping errors

These estimates use actual Gaussian integrals.  A shared standard Gaussian
couples any two scalar Gaussian reconstructions; the observable-lifting theorem
then retains their complete correlated-field marginals.
-/

noncomputable section
open MeasureTheory ProbabilityTheory
open scoped BigOperators NNReal

namespace NeuralGeneralization.RobustCompressionGaussian

theorem gaussian_power_integrable (μ : ℝ) (v : ℝ≥0) (n : ℕ) :
    Integrable (fun z : ℝ => z ^ n) (gaussianReal μ v) :=
  integrable_pow_of_mem_interior_integrableExpSet (by simp) n

theorem standard_gaussian_square :
    (∫ z : ℝ, z ^ 2 ∂gaussianReal 0 1) = 1 := by
  have h := variance_fun_id_gaussianReal (μ := 0) (v := 1)
  rw [variance_eq_integral measurable_id'.aemeasurable] at h
  simpa using h

theorem gaussian_affine_square (a b : ℝ) :
    (∫ z : ℝ, (a + b * z) ^ 2 ∂gaussianReal 0 1) = a ^ 2 + b ^ 2 := by
  have h₁ : Integrable (fun z : ℝ => z) (gaussianReal 0 1) := by
    simpa using gaussian_power_integrable 0 1 1
  have h₂ := gaussian_power_integrable 0 1 2
  have hfun : (fun z : ℝ => (a + b * z) ^ 2) =
      (fun z => a ^ 2 + (2 * a * b) * z + b ^ 2 * z ^ 2) := by
    funext z
    ring
  have hA : Integrable (fun z : ℝ => a ^ 2 + (2 * a * b) * z) (gaussianReal 0 1) :=
    (integrable_const (a ^ 2)).add (h₁.const_mul (2 * a * b))
  have hB : Integrable (fun z : ℝ => b ^ 2 * z ^ 2) (gaussianReal 0 1) :=
    h₂.const_mul (b ^ 2)
  rw [hfun, integral_add hA hB,
    integral_add (integrable_const (a ^ 2)) (h₁.const_mul (2 * a * b)), integral_const_mul,
    integral_const_mul, integral_const, integral_id_gaussianReal, standard_gaussian_square]
  simp

theorem scalar_gaussian_reconstruction_error (a b v w : ℝ) :
    (∫ z : ℝ, ((a + Real.sqrt v * z) - (b + Real.sqrt w * z)) ^ 2
      ∂gaussianReal 0 1) = (a - b) ^ 2 + (Real.sqrt v - Real.sqrt w) ^ 2 := by
  have hfun : (fun z : ℝ => ((a + Real.sqrt v * z) - (b + Real.sqrt w * z)) ^ 2) =
      (fun z => ((a - b) + (Real.sqrt v - Real.sqrt w) * z) ^ 2) := by
    funext z
    ring
  rw [hfun, gaussian_affine_square]

theorem square_sqrt_difference_le {v w : ℝ} (hv : 0 ≤ v) (hw : 0 ≤ w) :
    (Real.sqrt v - Real.sqrt w) ^ 2 ≤ |v - w| := by
  have hsv := Real.sq_sqrt hv
  have hsw := Real.sq_sqrt hw
  rcases le_total v w with h | h
  · rw [abs_of_nonpos (sub_nonpos.mpr h)]
    have hm := mul_nonneg (Real.sqrt_nonneg v) (sub_nonneg.mpr (Real.sqrt_le_sqrt h))
    nlinarith
  · rw [abs_of_nonneg (sub_nonneg.mpr h)]
    have hm := mul_nonneg (Real.sqrt_nonneg w) (sub_nonneg.mpr (Real.sqrt_le_sqrt h))
    nlinarith

theorem scalar_gaussian_reconstruction_bound (a b : ℝ) {v w : ℝ}
    (hv : 0 ≤ v) (hw : 0 ≤ w) :
    (∫ z : ℝ, ((a + Real.sqrt v * z) - (b + Real.sqrt w * z)) ^ 2
      ∂gaussianReal 0 1) ≤ (a - b) ^ 2 + |v - w| := by
  rw [scalar_gaussian_reconstruction_error]
  exact add_le_add le_rfl (square_sqrt_difference_le hv hw)

theorem standard_gaussian_affine_map (a : ℝ) (v : ℝ≥0) :
    (gaussianReal 0 1).map (fun z => a + Real.sqrt (v : ℝ) * z) = gaussianReal a v := by
  have hf : Measurable (fun z : ℝ => Real.sqrt (v : ℝ) * z) := by fun_prop
  have hg : Measurable (fun z : ℝ => a + z) := by fun_prop
  change (gaussianReal 0 1).map ((fun z : ℝ => a + z) ∘
    (fun z => Real.sqrt (v : ℝ) * z)) = _
  rw [← Measure.map_map hg hf, gaussianReal_map_const_mul, gaussianReal_map_const_add]
  congr 1
  · ring
  · apply NNReal.coe_injective
    simp [Real.sq_sqrt v.coe_nonneg]

/-- An explicit coupling, generated by one common standard Gaussian. -/
def scalarGaussianCoupling (a b : ℝ) (v w : ℝ≥0) :
    RobustStatistics.ProbabilityCoupling (gaussianReal a v) (gaussianReal b w) where
  joint := (gaussianReal 0 1).map
    (fun z => (a + Real.sqrt (v : ℝ) * z, b + Real.sqrt (w : ℝ) * z))
  probability := Measure.isProbabilityMeasure_map (by fun_prop)
  left := by
    rw [Measure.map_map measurable_fst (by fun_prop)]
    exact standard_gaussian_affine_map a v
  right := by
    rw [Measure.map_map measurable_snd (by fun_prop)]
    exact standard_gaussian_affine_map b w

theorem scalarGaussianCoupling_error (a b : ℝ) (v w : ℝ≥0) :
    (∫ p : ℝ × ℝ, (p.1 - p.2) ^ 2 ∂(scalarGaussianCoupling a b v w).joint) ≤
      (a - b) ^ 2 + |(v : ℝ) - w| := by
  change (∫ p : ℝ × ℝ, (p.1 - p.2) ^ 2 ∂(gaussianReal 0 1).map _) ≤ _
  rw [integral_map (by fun_prop) (by fun_prop)]
  exact scalar_gaussian_reconstruction_bound a b v.coe_nonneg w.coe_nonneg

/-- Coordinatewise saturation used only for the finite Gaussian reconstruction.
This is distinct from whole-source clipping and the final output score clip. -/
def gaussianClip (B z : ℝ) : ℝ := max (-B) (min B z)

theorem measurable_gaussianClip (B : ℝ) : Measurable (gaussianClip B) := by
  unfold gaussianClip
  fun_prop

theorem gaussianClip_error_fourth (B z : ℝ) (hB : 0 < B) :
    (z - gaussianClip B z) ^ 2 ≤ z ^ 4 / B ^ 2 := by
  apply (le_div_iff₀ (sq_pos_of_pos hB)).mpr
  by_cases hz : B ≤ z
  · rw [gaussianClip, min_eq_left hz, max_eq_right (by linarith)]
    have h₂ : B ^ 2 ≤ z ^ 2 := by nlinarith
    have he : (z - B) ^ 2 ≤ z ^ 2 := by nlinarith
    calc
      (z - B) ^ 2 * B ^ 2 ≤ z ^ 2 * B ^ 2 := mul_le_mul_of_nonneg_right he (sq_nonneg B)
      _ ≤ z ^ 2 * z ^ 2 := mul_le_mul_of_nonneg_left h₂ (sq_nonneg z)
      _ = z ^ 4 := by ring
  · rw [gaussianClip, min_eq_right (le_of_not_ge hz)]
    by_cases hz' : -B ≤ z
    · rw [max_eq_right hz', sub_self, zero_pow (by decide), zero_mul]
      positivity
    · rw [max_eq_left (le_of_not_ge hz')]
      have h₂ : B ^ 2 ≤ z ^ 2 := by nlinarith [lt_of_not_ge hz']
      have he : (z - -B) ^ 2 ≤ z ^ 2 := by nlinarith [lt_of_not_ge hz']
      calc
        (z - -B) ^ 2 * B ^ 2 ≤ z ^ 2 * B ^ 2 := mul_le_mul_of_nonneg_right he (sq_nonneg B)
        _ ≤ z ^ 2 * z ^ 2 := mul_le_mul_of_nonneg_left h₂ (sq_nonneg z)
        _ = z ^ 4 := by ring

theorem fourth_power_le_exp (z : ℝ) : z ^ 4 ≤ 32 * Real.exp (z ^ 2 / 4) := by
  have h := Real.pow_div_factorial_le_exp (z ^ 2 / 4) (by positivity) 2
  norm_num at h
  nlinarith

theorem gaussian_exp_square_le_two (v : ℝ≥0) (hv : (v : ℝ) ≤ 1) :
    (∫ z : ℝ, Real.exp (z ^ 2 / 4) ∂gaussianReal 0 v) ≤ 2 := by
  have hp : 0 < 1 - 2 * (1 / 4 : ℝ) * v := by linarith
  have hs := Real.sq_sqrt hp.le
  have hspos := Real.sqrt_pos.mpr hp
  have heq : (fun z : ℝ => Real.exp (z ^ 2 / 4)) =
      (fun z => Real.exp ((1 / 4) * z ^ 2)) := by
    funext z
    congr 1
    ring
  rw [heq, GaussianTail.integral_exp_mul_sq_gaussianReal v (1 / 4) hp, inv_eq_one_div]
  apply (div_le_iff₀ hspos).mpr
  nlinarith

theorem gaussian_fourth_moment_le (v : ℝ≥0) (hv : (v : ℝ) ≤ 1) :
    (∫ z : ℝ, z ^ 4 ∂gaussianReal 0 v) ≤ 64 := by
  have he : Integrable (fun z : ℝ => Real.exp (z ^ 2 / 4)) (gaussianReal 0 v) := by
    apply Integrable.of_integral_ne_zero
    have hp : 0 < 1 - 2 * (1 / 4 : ℝ) * v := by linarith
    have heq : (fun z : ℝ => Real.exp (z ^ 2 / 4)) =
        (fun z => Real.exp ((1 / 4) * z ^ 2)) := by
      funext z
      congr 1
      ring
    rw [heq, GaussianTail.integral_exp_mul_sq_gaussianReal v (1 / 4) hp]
    exact inv_ne_zero (Real.sqrt_pos.mpr hp).ne'
  have h := integral_mono (gaussian_power_integrable 0 v 4) (he.const_mul 32)
    fourth_power_le_exp
  rw [integral_const_mul] at h
  linarith [gaussian_exp_square_le_two v hv]

theorem gaussian_clip_error_integrable (v : ℝ≥0) (B : ℝ) (hB : 0 < B) :
    Integrable (fun z : ℝ => (z - gaussianClip B z) ^ 2) (gaussianReal 0 v) := by
  apply ((gaussian_power_integrable 0 v 4).div_const (B ^ 2)).mono'
    ((measurable_id.sub (measurable_gaussianClip B)).pow_const 2).aestronglyMeasurable
  exact Filter.Eventually.of_forall (fun z => by
    rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
    exact gaussianClip_error_fourth B z hB)

theorem gaussian_clip_error_le (v : ℝ≥0) (hv : (v : ℝ) ≤ 1)
    (B : ℝ) (hB : 0 < B) :
    (∫ z : ℝ, (z - gaussianClip B z) ^ 2 ∂gaussianReal 0 v) ≤ 64 / B ^ 2 := by
  calc
    _ ≤ ∫ z : ℝ, z ^ 4 / B ^ 2 ∂gaussianReal 0 v :=
      integral_mono (gaussian_clip_error_integrable v B hB)
        ((gaussian_power_integrable 0 v 4).div_const _) (fun z => gaussianClip_error_fourth B z hB)
    _ = (∫ z : ℝ, z ^ 4 ∂gaussianReal 0 v) / B ^ 2 := integral_div _ _
    _ ≤ 64 / B ^ 2 := div_le_div_of_nonneg_right (gaussian_fourth_moment_le v hv) (sq_nonneg B)

section Correlated

variable {Ω : Type*} [MeasurableSpace Ω] {m : ℕ}

/-- Only the coordinate marginals are prescribed.  No independence of the
Gaussian coordinates is used in this estimate. -/
theorem correlated_clip_error_sum (μ : Measure Ω) (Z : Fin m → Ω → ℝ)
    (hZ : ∀ i, Measurable (Z i)) (v : Fin m → ℝ≥0)
    (hlaw : ∀ i, μ.map (Z i) = gaussianReal 0 (v i))
    (hv : ∀ i, (v i : ℝ) ≤ 1) (B : ℝ) (hB : 0 < B) :
    (∫ ω, ∑ i, (Z i ω - gaussianClip B (Z i ω)) ^ 2 ∂μ) ≤
      64 * (m : ℝ) / B ^ 2 := by
  have hint (i : Fin m) : Integrable (fun ω => (Z i ω - gaussianClip B (Z i ω)) ^ 2) μ := by
    have hh := gaussian_clip_error_integrable (v i) B hB
    rw [← hlaw i] at hh
    exact (integrable_map_measure
      ((measurable_id.sub (measurable_gaussianClip B)).pow_const 2).aestronglyMeasurable
      (hZ i).aemeasurable).mp hh
  rw [integral_finsetSum Finset.univ (fun i _ => hint i)]
  calc
    _ ≤ ∑ i : Fin m, 64 / B ^ 2 := by
      apply Finset.sum_le_sum
      intro i hi
      have hh := integral_map (μ := μ) (hZ i).aemeasurable
        ((measurable_id.sub (measurable_gaussianClip B)).pow_const 2).aestronglyMeasurable
      rw [hlaw i] at hh
      simp only [Pi.sub_apply, id_eq] at hh
      rw [← hh]
      exact gaussian_clip_error_le (v i) (hv i) B hB
    _ = _ := by simp; ring

theorem correlated_clip_linear_error (μ : Measure Ω) (Z : Fin m → Ω → ℝ)
    (hZ : ∀ i, Measurable (Z i)) (v : Fin m → ℝ≥0)
    (hlaw : ∀ i, μ.map (Z i) = gaussianReal 0 (v i))
    (hv : ∀ i, (v i : ℝ) ≤ 1) (B : ℝ) (hB : 0 < B)
    (u : Fin m → ℝ) (hu : ∑ i, u i ^ 2 ≤ 1) :
    (∫ ω, (∑ i, u i * (Z i ω - gaussianClip B (Z i ω))) ^ 2 ∂μ) ≤
      64 * (m : ℝ) / B ^ 2 := by
  have hint (i : Fin m) : Integrable (fun ω => (Z i ω - gaussianClip B (Z i ω)) ^ 2) μ := by
    have hh := gaussian_clip_error_integrable (v i) B hB
    rw [← hlaw i] at hh
    exact (integrable_map_measure
      ((measurable_id.sub (measurable_gaussianClip B)).pow_const 2).aestronglyMeasurable
      (hZ i).aemeasurable).mp hh
  have hsum : Integrable (fun ω => ∑ i, (Z i ω - gaussianClip B (Z i ω)) ^ 2) μ :=
    integrable_finsetSum _ (fun i _ => hint i)
  have hpoint (ω : Ω) : (∑ i, u i * (Z i ω - gaussianClip B (Z i ω))) ^ 2 ≤
      ∑ i, (Z i ω - gaussianClip B (Z i ω)) ^ 2 := by
    calc
      _ ≤ (∑ i, u i ^ 2) * ∑ i, (Z i ω - gaussianClip B (Z i ω)) ^ 2 :=
        Finset.sum_mul_sq_le_sq_mul_sq Finset.univ _ _
      _ ≤ 1 * ∑ i, (Z i ω - gaussianClip B (Z i ω)) ^ 2 :=
        mul_le_mul_of_nonneg_right hu (Finset.sum_nonneg (fun i _ => sq_nonneg _))
      _ = _ := one_mul _
  have hmeas : Measurable (fun ω => (∑ i, u i * (Z i ω - gaussianClip B (Z i ω))) ^ 2) := by
    unfold gaussianClip
    fun_prop
  have hleft := hsum.mono' hmeas.aestronglyMeasurable
    (Filter.Eventually.of_forall (fun ω => by
      rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
      exact hpoint ω))
  exact (integral_mono hleft hsum hpoint).trans
    (correlated_clip_error_sum μ Z hZ v hlaw hv B hB)

end Correlated

end NeuralGeneralization.RobustCompressionGaussian

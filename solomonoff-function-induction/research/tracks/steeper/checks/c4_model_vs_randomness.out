  m=1: empirical P[sup >= m] = 0.1185  <= 2^-m = 0.5000
  m=2: empirical P[sup >= m] = 0.0545  <= 2^-m = 0.2500
  m=3: empirical P[sup >= m] = 0.0323  <= 2^-m = 0.1250
  m=4: empirical P[sup >= m] = 0.0143  <= 2^-m = 0.0625
  m=6: empirical P[sup >= m] = 0.0032  <= 2^-m = 0.0156
